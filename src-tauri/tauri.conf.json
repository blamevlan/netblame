{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netblame",
  "version": "0.1.0",
  "identifier": "com.netblame.app",
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "netblame",
        "width": 960,
        "height": 760,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
